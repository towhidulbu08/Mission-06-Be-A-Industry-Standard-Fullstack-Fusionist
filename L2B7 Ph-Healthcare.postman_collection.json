						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/doctor/apply-as-doctor/verify-email",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "doctor", "apply-as-doctor", "verify-email"]
						},
						"description": "Consumes the doctor application OTP (1 hour TTL) and marks the email verified."

							"raw": "{{baseUrl}}/api/v1/doctor/apply-as-doctor",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "doctor", "apply-as-doctor"]
						},
						"description": "multipart/form-data. The `data` field is a JSON *string* (the controller does JSON.parse on it) containing { user, doctor }. Files: `resume` (max 1) and `additionalFiles` (max 10), all uploaded to Cloudinary. Sends a verification OTP valid for 1 hour. Password is generated randomly and needPasswordChange is set."
					},
					"response": []
				},

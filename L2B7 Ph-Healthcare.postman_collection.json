{
	"info": {
		"_postman_id": "b7e2f1c4-8a3d-4f62-9c15-phhealthcare01",
		"name": "L2B7 Ph-Healthcare",
		"description": "PH Healthcare Backend API Collection (Express 5 + Prisma + PostgreSQL).\n\nBase URL: {{baseUrl}}\nAuth: Bearer token from Login / Verify Email ({{accessToken}}). Tokens are also set as cookies, but the cookie combo (sameSite=none + secure=false) is dropped by browsers, so prefer the body token.\n\nDomain notes:\n- Patient registration is two-step: register -> OTP email -> verify-email creates the user.\n- Doctor application is two-step: apply-as-doctor (multipart) -> verify-email -> admin approval.\n- Appointments are paid through bKash; the callback endpoint is public.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register Patient (Send OTP)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"patient@example.com\",\n  \"password\": \"Password@123\",\n  \"patient\": {\n    \"contactNumber\": \"+8801700000000\"\n  }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "register"]
						},
						"description": "Step 1 of patient signup. Stores hashed password + data in Redis and emails a 6-digit OTP (5 min TTL). No user row is created yet.\n\nPassword rules: min 8 chars, at least one uppercase, one lowercase, one digit, one special character."
					},
					"response": []
				},
				{
					"name": "Verify Patient Email",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"patient@example.com\",\n  \"otp\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/verify-email",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "verify-email"]
						},
						"description": "Step 2 of patient signup. Creates the user + patient rows and returns accessToken/refreshToken in the body (and cookies)."
					},
					"response": []
				},
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"patient@example.com\",\n  \"password\": \"Password@123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "login"]
						},
						"description": "Email + password login. Returns accessToken/refreshToken. Requires JWT_ACCESS_SECRET / JWT_REFRESH_SECRET to be configured."
					},
					"response": []
				},
				{
					"name": "Get Me",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/me",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "me"]
						},
						"description": "Current user profile. Roles: SUPER_ADMIN, ADMIN, DOCTOR, PATIENT."
					},
					"response": []
				},
				{
					"name": "Refresh Token",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/refresh-token",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "refresh-token"]
						},
						"description": "Reads the refreshToken cookie only (not a body field). Returns a new accessToken + refreshToken."
					},
					"response": []
				},

									"key": "data",
									"value": "{\"user\":{\"name\":\"Dr. Rahim\",\"email\":\"doctor.apply@example.com\"},\"doctor\":{\"specialization\":\"Cardiology\",\"licenseNumber\":\"LIC-12345\",\"qualifications\":\"MBBS, FCPS\",\"experienceYears\":5,\"address\":\"Dhaka, Bangladesh\",\"consultationFee\":1500,\"contactNumber\":\"+8801800000000\",\"bio\":\"Experienced cardiologist.\"}}",
